<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding_horizontal"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/screen_section_spacing"
        android:layout_marginTop="@dimen/screen_padding_vertical">

        <ImageView
            android:layout_width="@dimen/top_logo_size"
            android:layout_height="@dimen/top_logo_size"
            android:src="@drawable/mediavault_logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_section_spacing_small"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextScreenTitle"
                android:text="@string/app_name"
                android:textSize="24sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                style="@style/TextBody"
                android:text="@string/auto_about"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Scrollable Text Display Requirement 2.3 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/rounded_corners"
        android:padding="@dimen/card_content_padding"
        android:fadeScrollbars="false"
        android:scrollbarStyle="outsideOverlay">

        <TextView
            android:id="@+id/tv_about_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_regular"
            android:textSize="16sp"
            android:lineSpacingExtra="6dp"
            android:textColor="@color/text_secondary"
            android:text="@string/auto_mediavault_is_your_ultimate_companion_for_tracki" />
    </ScrollView>

    <Button
        android:id="@+id/btn_about_back"
        style="@style/BlueButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:text="@string/auto_back_to_settings" />

</LinearLayout>
