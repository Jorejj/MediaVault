<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/glass_card_bg"
    android:padding="16dp">

    <ImageView
        android:id="@+id/img_app_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <TextView
        android:id="@+id/text_app_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:fontFamily="@font/sf_pro_medium"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/text_app_package"
        app:layout_constraintStart_toEndOf="@id/img_app_icon"
        app:layout_constraintEnd_toStartOf="@id/switch_monitor"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/text_app_package"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textColor="?attr/colorTextSecondary"
        android:textSize="12sp"
        android:fontFamily="@font/sf_pro_regular"
        app:layout_constraintTop_toBottomOf="@id/text_app_name"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_app_icon"
        app:layout_constraintEnd_toStartOf="@id/switch_monitor" />

    <com.google.android.material.switchmaterial.SwitchMaterial
        android:id="@+id/switch_monitor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
