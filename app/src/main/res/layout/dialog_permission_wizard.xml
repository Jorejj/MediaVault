<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/glass_card_bg">

    <!-- Step Indicator -->
    <LinearLayout
        android:id="@+id/layout_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <View
            android:id="@+id/step_1_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/badge_dot" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="8dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.3" />

        <View
            android:id="@+id/step_2_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/badge_dot"
            android:alpha="0.3" />

        <View
            android:layout_width="40dp"
            android:layout_height="2dp"
            android:layout_marginHorizontal="8dp"
            android:background="?attr/colorOnSurface"
            android:alpha="0.3" />

        <View
            android:id="@+id/step_3_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/badge_dot"
            android:alpha="0.3" />
    </LinearLayout>

    <!-- Step Title -->
    <TextView
        android:id="@+id/text_step_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/sf_pro_bold"
        android:gravity="center"
        android:text="@string/auto_step_1_accessibility_service"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp" />

    <!-- Icon -->
    <ImageView
        android:id="@+id/img_step_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:src="@drawable/ic_accessibility"
        app:tint="@color/vault_red_primary" />

    <!-- Description -->
    <TextView
        android:id="@+id/text_step_description"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/sf_pro_regular"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="@string/auto_enable_the_accessibility_service_to_allow_mediav"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:alpha="0.8" />

    <!-- Status Indicator -->
    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/glass_pill_bg">

        <ImageView
            android:id="@+id/img_status_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/text_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/sf_pro_medium"
            android:text="@string/auto_not_enabled"
            android:textColor="@color/vault_red_primary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Action Button -->
    <Button
        android:id="@+id/btn_action"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/glass_pill_bg"
        android:fontFamily="@font/sf_pro_bold"
        android:text="@string/auto_enable_now"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp" />

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/sf_pro_medium"
            android:text="@string/auto_back"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_skip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@android:color/transparent"
            android:fontFamily="@font/sf_pro_medium"
            android:text="@string/auto_skip_for_now"
            android:textColor="?attr/colorOnSurface"
            android:alpha="0.6"
            android:textSize="14sp" />
    </LinearLayout>

</LinearLayout>
