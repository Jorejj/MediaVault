<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Glow Shadow (Simulated) - Restoring for consistency with light mode -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="24dp" />
            <padding
                android:left="2dp"
                android:top="2dp"
                android:right="2dp"
                android:bottom="2dp" />
        </shape>
    </item>

    <!-- Main Glass Shape -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_surface_color" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/vault_red_primary" />
        </shape>
    </item>
</layer-list>
