<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/background_base">

    <TextView
        android:id="@+id/tv_tv_series_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_tv_show_title"
        android:textSize="22sp"
        android:textColor="@android:color/black"
        android:fontFamily="@font/sf_pro_bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_select_episode"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_medium"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false" android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_season_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_season"
                android:inputType="number"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/sf_pro_medium"
                android:gravity="center" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_episode_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/auto_episode_2"
                android:inputType="number"
                android:textSize="18sp"
                android:textColor="@android:color/black"
                android:fontFamily="@font/sf_pro_medium"
                android:gravity="center" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/pb_resolving_tv"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_status_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_regular"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_resolve_and_play_tv"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_resolve_and_play"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/sf_pro_bold"
        android:background="@drawable/glass_pill_bg"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_cancel_tv"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_cancel"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_medium"
        android:background="@drawable/glass_card_bg" />

</LinearLayout>
