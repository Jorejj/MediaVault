<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="@color/background_base">

    <TextView
        android:id="@+id/tv_movie_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_movie_title"
        android:textSize="22sp"
        android:textColor="@android:color/black"
        android:fontFamily="@font/sf_pro_bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <ProgressBar
        android:id="@+id/pb_resolving_movie"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_status_movie"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_medium"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_retry_movie"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_retry"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/sf_pro_bold"
        android:background="@drawable/glass_pill_bg"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_cancel_movie"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_cancel"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_medium"
        android:background="@drawable/glass_card_bg" />

</LinearLayout>
