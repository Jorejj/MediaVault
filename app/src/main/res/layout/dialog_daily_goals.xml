<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/card_cyber_bg"
    android:fitsSystemWindows="true">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_set_your_daily_consumption_targets_leave_empty_o"
        android:textSize="14sp"
        android:textColor="?attr/colorTextSecondary"
        android:layout_marginBottom="16dp"
        android:fontFamily="@font/sf_pro_regular" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/auto_pages_per_day"
        android:layout_marginBottom="12dp"
        app:hintTextColor="?attr/colorTextSecondary"
        app:placeholderTextColor="?attr/colorTextSecondary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_goal_pages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="?attr/colorTextPrimary"
            android:fontFamily="@font/sf_pro_medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/auto_episodes_per_day"
        android:layout_marginBottom="12dp"
        app:hintTextColor="?attr/colorTextSecondary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_goal_episodes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="?attr/colorTextPrimary"
            android:fontFamily="@font/sf_pro_medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/auto_minutes_per_day"
        android:layout_marginBottom="16dp"
        app:hintTextColor="?attr/colorTextSecondary"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_goal_minutes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:textColor="?attr/colorTextPrimary"
            android:fontFamily="@font/sf_pro_medium" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_daily_reminder"
            android:textColor="?attr/colorTextPrimary"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/sf_pro_bold" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switch_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_enable_notification"
            android:textColor="?attr/colorTextPrimary"
            android:layout_marginBottom="12dp"
            android:minHeight="48dp"
            android:fontFamily="@font/sf_pro_medium" />
            
        <TextView
            android:id="@+id/tv_reminder_time"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/auto_s_8_00_pm"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:gravity="center_vertical"
            android:background="@drawable/glass_input_bg"
            android:drawableEnd="@drawable/ic_clock"
            android:drawablePadding="8dp"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="16sp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/sf_pro_bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_test_reminder_now"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_test_reminder_now"
            android:textAllCaps="false"
            android:textColor="@color/accent_blue" />
             
    </LinearLayout>

</LinearLayout>
