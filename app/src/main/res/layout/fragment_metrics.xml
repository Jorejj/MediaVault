<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:scrollbarStyle="outsideOverlay"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_vertical"
        android:paddingBottom="80dp"
        android:clipToPadding="false">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_section_spacing_small">

            <ImageView
                android:id="@+id/img_logo"
                android:layout_width="@dimen/top_logo_size"
                android:layout_height="@dimen/top_logo_size"
                android:src="@drawable/mediavault_logo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_section_spacing_small"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/img_logo"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tv_metrics_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextScreenTitle"
                    android:text="@string/Stats"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/tv_metrics_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextBody"
                    android:text="@string/auto_your_vault_activity"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/binge_calculator"
                    android:textColor="?attr/colorTextPrimary"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:columnCount="3"
                    android:useDefaultMargins="true">

                    <TextView
                        android:id="@+id/txt_home_watch_time"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/auto_s_0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_home_pages_read"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/auto_s_0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_home_ongoing_items"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/auto_s_0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/auto_watch_time"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/pages_read"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/auto_ongoing_titles"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/txt_home_episodes_watched"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:text="@string/auto_s_0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_home_books_completed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:text="@string/auto_s_0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/txt_home_avg_rating"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="8dp"
                        android:text="@string/auto_s_0_0_2"
                        android:textColor="?attr/colorTextPrimary"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/auto_episodes"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/auto_books_read"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:text="@string/avg_rating_label"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp" />
                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_heavy"
                android:text="@string/auto_daily_goals"
                android:textAllCaps="true"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_metrics_edit_goals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/sf_pro_bold"
                android:padding="4dp"
                android:text="@string/auto_edit_goals"
                android:textColor="@color/netflix_red"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_metrics_daily_goals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_metrics_goals_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_today_s_progress"
                    android:fontFamily="@font/sf_pro_bold"
                    android:textSize="18sp"
                    android:textColor="?attr/colorTextPrimary"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_metrics_goals_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_no_goals_set_yet_tap_edit_goals_to_start"
                    android:gravity="center"
                    android:textColor="?attr/colorTextSecondary"
                    android:visibility="gone"
                    android:padding="8dp"/>

                <TextView
                    android:id="@+id/tv_metrics_congratulations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_all_daily_goals_achieved_outstanding_work"
                    android:gravity="center"
                    android:textColor="@color/accent_green"
                    android:fontFamily="@font/sf_pro_heavy"
                    android:textSize="16sp"
                    android:visibility="gone"
                    android:padding="12dp"
                    android:background="@drawable/rounded_bg_gray"
                    android:backgroundTint="#201DB954"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:id="@+id/layout_metrics_goal_pages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pages_read"
                            android:fontFamily="@font/sf_pro_medium"
                            android:textColor="?attr/colorTextPrimary"/>
                        <TextView
                            android:id="@+id/tv_metrics_progress_pages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0_20"
                            android:fontFamily="@font/sf_pro_bold"
                            android:textColor="?attr/colorTextSecondary"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_metrics_goal_pages"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_bar_rounded_blue"
                        android:max="100"
                        android:progress="0"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_metrics_goal_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_episodes_watched"
                            android:fontFamily="@font/sf_pro_medium"
                            android:textColor="?attr/colorTextPrimary"/>
                        <TextView
                            android:id="@+id/tv_metrics_progress_episodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0_3"
                            android:fontFamily="@font/sf_pro_bold"
                            android:textColor="?attr/colorTextSecondary"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_metrics_goal_episodes"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_bar_rounded_green"
                        android:max="100"
                        android:progress="0"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layout_metrics_goal_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_minutes_watched"
                            android:fontFamily="@font/sf_pro_medium"
                            android:textColor="?attr/colorTextPrimary"/>
                        <TextView
                            android:id="@+id/tv_metrics_progress_minutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0_60"
                            android:fontFamily="@font/sf_pro_bold"
                            android:textColor="?attr/colorTextSecondary"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_metrics_goal_minutes"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_bar_rounded_orange"
                        android:max="100"
                        android:progress="0"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/overview"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="13sp"
                    android:letterSpacing="0.1"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:alignmentMode="alignMargins"
                    android:layout_gravity="center_horizontal"
                    android:useDefaultMargins="true">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_count_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0"
                            android:textColor="?attr/colorTextPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="@string/auto_completed"
                            android:textColor="?attr/colorTextSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_count_ongoing"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0"
                            android:textColor="?attr/colorTextPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="@string/auto_ongoing"
                            android:textColor="?attr/colorTextSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_count_planning"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0"
                            android:textColor="?attr/colorTextPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_planning"
                            android:textColor="?attr/colorTextSecondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:gravity="center_horizontal"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txt_count_dropped"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0"
                            android:textColor="?attr/colorTextPrimary"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_dropped"
                            android:textColor="?attr/colorTextSecondary" />
                    </LinearLayout>

                </GridLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/auto_streak_snapshot"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txt_streak_snapshot_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:text="@string/auto_last_7_nights_0_7_goal_nights_met"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:weightSum="7">

                    <TextView
                        android:id="@+id/txt_streak_day_0"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/auto_text_3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextPrimary"
                        android:background="@drawable/glass_input_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/txt_streak_day_1"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/auto_text_3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextPrimary"
                        android:background="@drawable/glass_input_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/txt_streak_day_2"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/auto_text_3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextPrimary"
                        android:background="@drawable/glass_input_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/txt_streak_day_3"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/auto_text_3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextPrimary"
                        android:background="@drawable/glass_input_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/txt_streak_day_4"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/auto_text_3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextPrimary"
                        android:background="@drawable/glass_input_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/txt_streak_day_5"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/auto_text_3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextPrimary"
                        android:background="@drawable/glass_input_bg"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:id="@+id/txt_streak_day_6"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="@string/auto_text_3"
                        android:textStyle="bold"
                        android:textColor="?attr/colorTextPrimary"
                        android:background="@drawable/glass_input_bg" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/vault_composition"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/auto_genre_distribution"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="16sp" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="350dp">

                    <WebView
                        android:id="@+id/webview_vault_composition"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="@string/auto_library_health"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:text="@string/completed_vs_backlog"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_backlog_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/backlog_status_healthy"
                        android:textColor="@color/accent_green"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <ProgressBar
                        android:id="@+id/progress_backlog_health"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:progress="0"
                        android:progressDrawable="@drawable/custom_progress_bar" />

                    <TextView
                        android:id="@+id/txt_backlog_percentage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_s_0_completed"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/auto_consumption_habits"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <com.google.android.material.tabs.TabLayout
                    android:id="@+id/tab_layout_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:tabMode="scrollable"
                    app:tabGravity="start"
                    app:tabInlineLabel="true"
                    app:tabSelectedTextColor="@color/vault_red_primary"
                    app:tabIndicatorColor="@color/vault_red_primary"
                    android:background="@android:color/transparent">
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daily" />
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/weekly" />
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/monthly" />
                    <com.google.android.material.tabs.TabItem
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_all_time" />
                </com.google.android.material.tabs.TabLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="330dp"
                    android:layout_marginBottom="16dp">

                    <WebView
                        android:id="@+id/webview_monthly_activity"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardBackgroundColor="@color/glass_surface_color"
                        app:strokeColor="@color/glass_border_soft"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/txt_top_genre"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:text="@string/auto_top_genre"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextPrimary"
                            android:textSize="15sp" />
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        app:cardBackgroundColor="@color/glass_surface_color"
                        app:strokeColor="@color/glass_border_soft"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/txt_avg_rating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:padding="12dp"
                            android:text="@string/auto_avg_rating_0"
                            android:textStyle="bold"
                            android:textColor="?attr/colorTextPrimary"
                            android:textSize="15sp" />
                    </com.google.android.material.card.MaterialCardView>

                </GridLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
