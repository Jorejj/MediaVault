<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="10dp"
    android:background="@drawable/glass_card_bg"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/tv_row_episode_number"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:text="@string/auto_s_1" />

    <TextView
        android:id="@+id/tv_row_episode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@android:color/white"
        android:text="@string/auto_episode_title" />

    <TextView
        android:id="@+id/tv_row_episode_status"
        android:layout_width="90dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="@color/text_secondary"
        android:text="@string/auto_pending" />

</LinearLayout>

