<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Glass Background Color (Alpha handled in colors.xml) -->
    <solid android:color="@color/glass_surface_color" />
    
    <!-- Rounded Corners -->
    <corners android:radius="24dp" />
    
    <!-- Subtle Border for Definition -->
    <stroke
        android:width="1.5dp"
        android:color="@color/glass_border_soft" />
        
</shape>
