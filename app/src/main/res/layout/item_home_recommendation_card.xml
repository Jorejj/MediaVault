<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:minHeight="340dp"
    android:layout_marginEnd="12dp"
    app:cardBackgroundColor="@color/glass_surface_color"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_border_soft"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/image_recommend_cover"
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:scaleType="centerCrop"
            android:src="@drawable/cinematic_bg" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/text_recommend_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/rating_pill_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/auto_status_loading"
                android:textColor="@color/ongoing_red"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/text_recommend_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_bold"
                android:gravity="center"
                android:maxLines="2"
                android:text="@string/auto_untitled"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/text_recommend_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_regular"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/auto_status_loading"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/text_recommend_progress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:ellipsize="end"
                android:fontFamily="@font/sf_pro_medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/auto_progress_placeholder"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_recommend_open"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="@string/auto_watch_now"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:backgroundTint="@color/vault_red_primary"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_recommend_add"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/auto_add_to_library_short"
                    android:textAllCaps="false"
                    android:textSize="12sp"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/vault_red_primary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
