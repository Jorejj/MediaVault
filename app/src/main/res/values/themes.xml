<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MediaVault" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary Brand Colors -->
        <item name="colorPrimary">@color/vault_red_primary</item>
        <item name="colorPrimaryVariant">@color/vault_red_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        
        <!-- Secondary Brand Colors -->
        <item name="colorSecondary">@color/vault_red_light</item>
        <item name="colorSecondaryVariant">@color/vault_red_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        
        <!-- Status Bar -->
        <item name="android:statusBarColor">@color/background_base</item>
        <item name="android:windowLightStatusBar">true</item>
        
        <!-- Backgrounds -->
        <item name="android:windowBackground">@color/background_base</item>
        <item name="colorSurface">@color/background_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        
        <!-- Custom Attributes -->
        <item name="colorCardBackground">@color/glass_surface_color</item>
        <item name="colorBottomNav">@color/nav_background</item>
        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorIconTint">@color/text_primary</item>
        
        <!-- Typography Defaults -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.MediaVault.Starting" parent="Theme.MediaVault">
         <item name="android:windowBackground">@color/background_base</item>
    </style>
    
    <style name="Theme.MediaVault.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.MediaVault.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>
