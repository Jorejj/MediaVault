<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MediaVault.Starting" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="s">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="s">@color/white</item>

        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.MediaVault" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/main_blue</item>
        <item name="colorPrimaryVariant">@color/logo_text</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/accent_blue</item>
        <item name="colorSecondaryVariant">@color/vault_accent_blue</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:statusBarColor">?attr/colorCardBackground</item>
        <item name="android:windowLightStatusBar">true</item>

        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorCardBackground">@color/bg_card</item>
        <item name="colorBottomNav">@color/nav_bg</item>
        <item name="colorTextPrimary">@color/text_primary</item>
        <item name="colorTextSecondary">@color/text_secondary</item>
        <item name="colorIconTint">@color/black</item>
    </style>

    <style name="Theme.MediaVault.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />
    <style name="Theme.MediaVault.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>