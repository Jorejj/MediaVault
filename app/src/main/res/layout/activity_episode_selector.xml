<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_base">

    <TextView
        android:id="@+id/tv_episode_selector_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_anime_title"
        android:textSize="22sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/sf_pro_bold"
        android:gravity="center"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/auto_select_episode_to_watch"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_medium"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_episode_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_episode"
            android:inputType="number"
            android:textSize="18sp"
            android:textColor="@android:color/white"
            android:fontFamily="@font/sf_pro_medium"
            android:gravity="center" />
    </com.google.android.material.textfield.TextInputLayout>

    <ProgressBar
        android:id="@+id/pb_resolving"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/status"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_regular"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btn_resolve_and_play"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_resolve_and_play"
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:fontFamily="@font/sf_pro_bold"
        android:background="@drawable/glass_pill_bg"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_episode_table"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/glass_card_bg">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/auto_text_2"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_episode_2"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="@string/status"
            android:gravity="end"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_episode_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp"
        android:scrollbars="vertical" />

    <Button
        android:id="@+id/btn_cancel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_cancel"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="@font/sf_pro_medium"
        android:background="@drawable/glass_card_bg" />

</LinearLayout>
