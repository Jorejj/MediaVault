<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/glass_surface_color"
    app:strokeColor="@color/glass_border_soft"
    app:strokeWidth="1dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/iv_thumbnail_container"
            android:layout_width="60dp"
            android:layout_height="80dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/iv_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@color/grey_300"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iv_thumbnail_container"
            android:layout_toStartOf="@+id/tv_timestamp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Title of the Movie . Anime"
            android:textColor="?attr/colorTextPrimary"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_title"
            android:layout_toEndOf="@id/iv_thumbnail_container"
            android:layout_toStartOf="@+id/tv_timestamp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Anime - Episode 12 / 25"
            android:textColor="@color/netflix_red"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignTop="@id/tv_title"
            android:text="2h ago"
            android:textColor="@color/grey_600"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_subtitle"
            android:layout_toEndOf="@id/iv_thumbnail_container"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="8dp"
                android:layout_weight="1"
                android:progressDrawable="@drawable/custom_progress_bar"
                android:progress="48"/>

            <TextView
                android:id="@+id/tv_progress_percentage"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:gravity="end"
                android:text="48%"
                android:textColor="@color/grey_600"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_pill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_subtitle"
            android:layout_marginTop="32dp"
            android:layout_toEndOf="@id/iv_thumbnail_container"
            android:background="@drawable/rating_pill_bg"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="Ongoing"
            android:textSize="10sp"
            android:textColor="@color/netflix_red"
            android:visibility="gone"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
