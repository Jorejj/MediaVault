<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#82303643"
                android:centerColor="#A5485870"
                android:endColor="#BF5A6D88" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:left="0.5dp"
        android:top="0.5dp"
        android:right="0.5dp"
        android:bottom="0.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:left="1.5dp"
        android:top="1.5dp"
        android:right="1.5dp"
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="20.5dp" />
            <stroke
                android:width="1.2dp"
                android:color="#7AFFFFFF" />
        </shape>
    </item>
</layer-list>
