<?xml version="1.0" encoding="utf-8"?>
<!-- Main Floating Assistant with State Containers -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <!-- STATE: IDLE - Compact draggable anchor -->
    <RelativeLayout
        android:id="@+id/state_idle"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/glass_pill_bg"
        android:elevation="12dp"
        android:visibility="visible">

        <ImageView
            android:id="@+id/idle_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_centerInParent="true"
            android:src="@drawable/ic_vault"
            android:contentDescription="@string/auto_mediavault_assistant"
            android:alpha="0.9" />

        <!-- Badge for notifications -->
        <View
            android:id="@+id/idle_badge"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="8dp"
            android:background="@color/vault_red_primary"
            android:visibility="gone" />
    </RelativeLayout>

    <!-- STATE: DETECTED_PROMPT - Show detected media with actions -->
    <ScrollView
        android:id="@+id/state_detected_prompt"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_card_bg"
        android:elevation="12dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/detected_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_detected_media"
            android:textSize="12sp"
            android:fontFamily="@font/sf_pro_medium"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/detected_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_book_title_here"
            android:textSize="16sp"
            android:fontFamily="@font/sf_pro_bold"
            android:textColor="@color/text_primary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_add_to_library"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_regular"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btn_ignore"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/auto_not_now"
                android:textSize="14sp"
                android:fontFamily="@font/sf_pro_regular"
                android:textColor="@color/text_secondary"
                android:textAllCaps="false"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_yes_add"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="@string/auto_add"
                android:textSize="14sp"
                android:fontFamily="@font/sf_pro_bold"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:backgroundTint="@color/vault_red_primary"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- STATE: EDIT_PROMPT - Manual title correction -->
    <LinearLayout
        android:id="@+id/state_edit_prompt"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glass_card_bg"
        android:padding="16dp"
        android:elevation="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/auto_edit_title"
            android:textSize="16sp"
            android:fontFamily="@font/sf_pro_bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_title_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/auto_enter_correct_title"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_regular"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/glass_pill_bg"
            android:padding="12dp"
            android:maxLines="2"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <Button
                android:id="@+id/btn_cancel_edit"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/auto_cancel"
                android:textSize="14sp"
                android:fontFamily="@font/sf_pro_regular"
                android:textColor="@color/text_secondary"
                android:background="@android:color/transparent"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btn_search"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="@string/search"
                android:textSize="14sp"
                android:fontFamily="@font/sf_pro_bold"
                android:textColor="@android:color/white"
                android:backgroundTint="@color/vault_red_primary"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:layout_marginStart="8dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- STATE: EXPANDED_MENU - Manual controls -->
    <ScrollView
        android:id="@+id/state_expanded_menu"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:background="@drawable/glass_card_bg"
        android:elevation="12dp"
        android:fillViewport="true"
        android:scrollbars="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_quick_actions"
            android:textSize="16sp"
            android:fontFamily="@font/sf_pro_bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/auto_fast_controls_for_tracking_and_library_access"
            android:textSize="13sp"
            android:fontFamily="@font/sf_pro_regular"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/menu_force_scan"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/auto_scan_current_screen"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_medium"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:background="@drawable/glass_pill_bg"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/menu_dismiss_detected"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/auto_dismiss_detected_media"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_medium"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:background="@drawable/glass_pill_bg"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/menu_toggle_title_tracking"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/auto_automatic_title_tracking_on"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_medium"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:background="@drawable/glass_pill_bg"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/menu_toggle_progress_tracking"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/auto_automatic_media_progress_on"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_medium"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:background="@drawable/glass_pill_bg"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/menu_open_library"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/auto_open_library"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_medium"
            android:textColor="@color/text_primary"
            android:textAllCaps="false"
            android:background="@drawable/glass_pill_bg"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="8dp" />

            <Button
            android:id="@+id/menu_close"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/auto_close"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_regular"
            android:textColor="@color/text_secondary"
            android:textAllCaps="false"
            android:background="@android:color/transparent"
            android:gravity="center" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
