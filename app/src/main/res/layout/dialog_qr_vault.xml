<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <eightbitlab.com.blurview.BlurView
        android:id="@+id/blur_view_dialog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:blurOverlayColor="@color/glass_surface_color" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="@color/glass_surface_color"
        app:strokeColor="@color/glass_border_soft"
        app:strokeWidth="1dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="16dp">

        <ImageView
            android:id="@+id/img_qr_code"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:contentDescription="@string/qr_vault"
            android:src="@drawable/mediavault_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Scan this QR to import favorites offline"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
