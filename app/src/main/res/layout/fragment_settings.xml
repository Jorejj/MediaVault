<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/app_logo"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tv_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/colorTextPrimary"
        app:layout_constraintBottom_toBottomOf="@id/img_logo"
        app:layout_constraintTop_toTopOf="@id/img_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="100dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorCardBackground"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Settings"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorTextSecondary"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A888888"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp">

                        <ImageView android:id="@+id/icon_darkmode" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Dark Mode" android:layout_toEndOf="@id/icon_darkmode" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_theme"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="false"
                            app:trackTint="#1A888888"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/row_export_data"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_export" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Export Data" android:layout_toEndOf="@id/icon_export" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/row_clear_database"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_clear" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#FF0000"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Clear Database" android:layout_toEndOf="@id/icon_clear" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#FF0000"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#FF0000"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/row_terms"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_terms" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Terms of Use" android:layout_toEndOf="@id/icon_terms" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/row_backup"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_backup" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Backup &amp; Restore" android:layout_toEndOf="@id/icon_backup" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_shake" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Shake Sensitivity" android:layout_toEndOf="@id/icon_shake" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_vault" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Vault Management" android:layout_toEndOf="@id/icon_vault" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="?attr/colorCardBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="More"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="?attr/colorTextSecondary"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#1A888888"/>

                    <RelativeLayout
                        android:id="@+id/row_privacy"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_privacy" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Privacy Policy" android:layout_toEndOf="@id/icon_privacy" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_help" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Help" android:layout_toEndOf="@id/icon_help" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/btn_about"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_about" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="About" android:layout_toEndOf="@id/icon_about" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="?attr/colorTextPrimary"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="?attr/colorIconTint"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
