<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    tools:context=".ui.home.HomeFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_vertical"
        android:paddingBottom="@dimen/screen_bottom_spacing">

        <!-- Service Status Banner (shown when permissions missing) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_service_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/vault_red_soft"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/vault_red_primary"
                    android:contentDescription="@string/auto_warning" />

                <TextView
                    android:id="@+id/text_service_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="@string/auto_tracking_disabled"
                    android:textColor="@color/vault_red_dark"
                    android:textSize="14sp"
                    android:fontFamily="@font/sf_pro_medium" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_enable_service"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="@string/auto_enable"
                    android:textSize="12sp"
                    app:backgroundTint="@color/vault_red_primary"
                    app:cornerRadius="8dp"
                    style="@style/Widget.Material3.Button" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/screen_section_spacing">

            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="@dimen/top_logo_size"
                android:layout_height="@dimen/top_logo_size"
                android:src="@drawable/mediavault_logo"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_section_spacing_small"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_logo"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextScreenTitle"
                    android:text="@string/mediavault"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextBody"
                    android:text="@string/auto_your_universal_media_hub"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/pager_spotlight"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingVertical="12dp"
                android:paddingHorizontal="12dp"
                />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/screen_section_spacing_small"
            android:gravity="top"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_weight="1"
                app:cardBackgroundColor="@color/glass_surface_color"
                app:strokeColor="@color/glass_border_soft"
                app:strokeWidth="1dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_chart"
                            app:tint="?attr/colorTextPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            style="@style/TextSectionTitle"
                            android:text="@string/binge_calculator"
                            android:textSize="18sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_watch"
                                app:tint="?attr/colorTextSecondary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/auto_watch_time"
                                android:textColor="?attr/colorTextSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_watch_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextStatValue"
                            android:text="@string/auto_s_0"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_library"
                                app:tint="?attr/colorTextSecondary" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/pages_read"
                                android:textColor="?attr/colorTextSecondary"
                                android:textSize="11sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_pages_read"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextStatValue"
                            android:text="@string/auto_s_0"
                            android:textSize="20sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <ImageView
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_clock"
                                app:tint="@color/ongoing_red" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/auto_ongoing_titles"
                                android:textColor="@color/ongoing_red"
                                android:textSize="11sp" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tv_ongoing_items"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/TextStatValue"
                            android:text="@string/auto_s_0"
                            android:textColor="@color/ongoing_red"
                            android:textSize="20sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_shake"
                android:layout_width="0dp"
                android:layout_height="220dp"
                android:layout_marginStart="@dimen/screen_section_spacing_small"
                android:layout_weight="0.65"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/glass_surface_color"
                app:strokeColor="@color/glass_border_soft"
                app:strokeWidth="1dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp">

                    <ImageView
                        android:id="@+id/iv_shake_illustration"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:src="@drawable/ic_shake" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        style="@style/TextSectionTitle"
                        android:gravity="center"
                        android:text="@string/auto_shake_to_ndecide"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false" android:orientation="horizontal"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_movie"
                        app:tint="?attr/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tv_episodes_watched"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/sf_pro_heavy"
                        android:text="@string/auto_s_0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_episodes"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_library"
                        app:tint="?attr/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tv_books_completed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/sf_pro_heavy"
                        android:text="@string/auto_s_0"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_books_read"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_star"
                        app:tint="?attr/colorTextPrimary" />

                    <TextView
                        android:id="@+id/tv_avg_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/sf_pro_heavy"
                        android:text="@string/auto_s_0_0_2"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/avg_rating_label"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_analyze_habits"
            style="@style/BlueButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="@string/analyze_habits" />

        <TextView
            android:id="@+id/tv_view_detailed_stats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/view_detailed_stats"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Streak Section -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_streak"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_heavy"
                        android:text="@string/auto_current_streak"
                        android:textAllCaps="true"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="12sp"
                        android:letterSpacing="0.1"/>

                    <TextView
                        android:id="@+id/tv_streak_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="@font/sf_pro_bold"
                        android:text="@string/auto_you_re_on_fire_keep_it_up"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="16sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_streak_count_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_heavy"
                    android:text="@string/auto_s_5"
                    android:textColor="@color/vault_red_primary"
                    android:textSize="36sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/auto_days"
                    android:textColor="@color/vault_red_primary"
                    android:textSize="12sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/sf_pro_heavy"
                android:text="@string/auto_daily_goals"
                android:textAllCaps="true"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_edit_goals"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/sf_pro_bold"
                android:padding="4dp"
                android:text="@string/auto_edit_goals"
                android:textColor="@color/netflix_red"
                android:textSize="14sp" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_daily_goals"
            style="@style/Widget.MaterialComponents.CardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/glass_surface_color"
            app:strokeColor="@color/glass_border_soft"
            app:strokeWidth="1dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_goals_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_today_s_progress"
                    android:fontFamily="@font/sf_pro_bold"
                    android:textSize="18sp"
                    android:textColor="?attr/colorTextPrimary"
                    android:layout_marginBottom="8dp"/>
                
                <TextView
                    android:id="@+id/tv_goals_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_no_goals_set_yet_tap_edit_goals_to_start"
                    android:gravity="center"
                    android:textColor="?attr/colorTextSecondary"
                    android:visibility="gone"
                    android:padding="8dp"/>
                
                <TextView
                    android:id="@+id/tv_congratulations"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/auto_all_daily_goals_achieved_outstanding_work"
                    android:gravity="center"
                    android:textColor="@color/accent_green"
                    android:fontFamily="@font/sf_pro_heavy"
                    android:textSize="16sp"
                    android:visibility="gone"
                    android:padding="12dp"
                    android:background="@drawable/rounded_bg_gray"
                    android:backgroundTint="#201DB954"
                    android:layout_marginBottom="16dp"/>
                <!-- Pages Goal -->
                <LinearLayout
                    android:id="@+id/layout_goal_pages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/pages_read"
                            android:fontFamily="@font/sf_pro_medium"
                            android:textColor="?attr/colorTextPrimary"/>
                        <TextView
                            android:id="@+id/tv_progress_pages"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0_20"
                            android:fontFamily="@font/sf_pro_bold"
                            android:textColor="?attr/colorTextSecondary"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_goal_pages"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_bar_rounded_blue"
                        android:max="100"
                        android:progress="0"/>
                </LinearLayout>

                <!-- Episodes Goal -->
                <LinearLayout
                    android:id="@+id/layout_goal_episodes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_episodes_watched"
                            android:fontFamily="@font/sf_pro_medium"
                            android:textColor="?attr/colorTextPrimary"/>
                        <TextView
                            android:id="@+id/tv_progress_episodes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0_3"
                            android:fontFamily="@font/sf_pro_bold"
                            android:textColor="?attr/colorTextSecondary"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_goal_episodes"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_bar_rounded_green"
                        android:max="100"
                        android:progress="0"/>
                </LinearLayout>

                <!-- Minutes Goal -->
                <LinearLayout
                    android:id="@+id/layout_goal_minutes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/auto_minutes_watched"
                            android:fontFamily="@font/sf_pro_medium"
                            android:textColor="?attr/colorTextPrimary"/>
                        <TextView
                            android:id="@+id/tv_progress_minutes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/auto_s_0_60"
                            android:fontFamily="@font/sf_pro_bold"
                            android:textColor="?attr/colorTextSecondary"/>
                    </LinearLayout>
                    <ProgressBar
                        android:id="@+id/pb_goal_minutes"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="8dp"
                        android:progressDrawable="@drawable/progress_bar_rounded_orange"
                        android:max="100"
                        android:progress="0"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
