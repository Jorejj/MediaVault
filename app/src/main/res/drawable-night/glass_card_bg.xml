<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <!-- Simulated blurred dark glass (low brightness) -->
            <gradient
                android:angle="135"
                android:startColor="#F21E1E1E"
                android:centerColor="#E6121212"
                android:endColor="#F20A0A0A" />
            <corners android:radius="22dp" />
            <stroke
                android:width="1dp"
                android:color="#4DFFFFFF" />
        </shape>
    </item>
</layer-list>
