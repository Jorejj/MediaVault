<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <ImageView
        android:id="@+id/img_logo"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="24dp"
        android:layout_marginTop="24dp"
        android:src="@drawable/mediavault_logo"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <TextView
        android:id="@+id/tv_screen_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Settings"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#000000"
        app:layout_constraintBottom_toBottomOf="@id/img_logo"
        app:layout_constraintTop_toTopOf="@id/img_logo"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/img_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        android:paddingBottom="100dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="Settings"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#888888"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp">

                        <ImageView android:id="@+id/icon_darkmode" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Dark Mode" android:layout_toEndOf="@id/icon_darkmode" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <androidx.appcompat.widget.SwitchCompat android:id="@+id/switch_theme"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:checked="false"
                            app:trackTint="#EAEFEF"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_terms" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Terms of Use" android:layout_toEndOf="@id/icon_terms" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#333333"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/row_backup"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_backup" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Backup &amp; Restore" android:layout_toEndOf="@id/icon_backup" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#333333"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_shake" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Shake Sensitivity" android:layout_toEndOf="@id/icon_shake" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#333333"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_vault" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Vault Management" android:layout_toEndOf="@id/icon_vault" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#333333"/>
                    </RelativeLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="16dp"
                        android:text="More"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        android:textColor="#888888"/>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#F0F0F0"/>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_privacy" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Privacy Policy" android:layout_toEndOf="@id/icon_privacy" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#333333"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_help" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Help" android:layout_toEndOf="@id/icon_help" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#333333"/>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/btn_about"
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:paddingHorizontal="16dp"
                        android:clickable="true" android:focusable="true" android:background="?attr/selectableItemBackground">

                        <ImageView android:id="@+id/icon_about" android:layout_width="24dp" android:layout_height="24dp"
                            android:src="@drawable/ic_settings1" android:layout_centerVertical="true" app:tint="#333333"/>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="About" android:layout_toEndOf="@id/icon_about" android:layout_marginStart="16dp"
                            android:layout_centerVertical="true" android:textSize="16sp" android:textStyle="bold" android:textColor="#333333"/>

                        <ImageView android:layout_width="20dp" android:layout_height="20dp"
                            android:src="@drawable/ic_chevron_right" android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true" app:tint="#333333"/>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="100dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_gravity="bottom"
            android:background="@android:color/white"
            android:orientation="horizontal"
            android:weightSum="5"
            android:gravity="center_vertical"
            android:elevation="10dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings1"
                    app:tint="#0088FF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Home"
                    android:textSize="10sp"
                    android:textColor="#0088FF"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings1"
                    app:tint="#444444"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Library"
                    android:textSize="10sp"
                    android:textColor="#444444"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings1"
                    app:tint="#444444"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stats"
                    android:textSize="10sp"
                    android:textColor="#444444"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings1"
                    app:tint="#444444"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="10sp"
                    android:textColor="#444444"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginBottom="35dp"
            android:src="@drawable/ic_settings1"
            app:backgroundTint="#0088FF"
            app:tint="@android:color/white"
            app:elevation="6dp"
            app:fabSize="normal" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
