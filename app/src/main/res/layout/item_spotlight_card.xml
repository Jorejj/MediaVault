<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_spotlight"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glass_card_bg"
    app:cardBackgroundColor="?attr/colorCardBackground"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_border"
    app:strokeWidth="1dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_spotlight_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/cover_gradient_overlay" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="bottom"
            android:orientation="vertical"
            android:padding="@dimen/card_content_padding">

            <TextView
                android:id="@+id/tv_spotlight_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_medium"
                android:text="Currently Watching / Reading"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tv_spotlight_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/sf_pro_heavy"
                android:text="Backlog Spotlight"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <ProgressBar
                android:id="@+id/progress_spotlight"
                android:layout_width="match_parent"
                android:layout_height="10dp"
                android:layout_marginTop="14dp"
                android:progress="62"
                android:progressDrawable="@drawable/custom_progress_bar" />

            <TextView
                android:id="@+id/tv_spotlight_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/rating_pill_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Ongoing"
                android:textColor="@color/ongoing_red"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_progress_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Alert received: Progress tracking is active."
                android:textColor="#D7E3FC"
                android:textSize="11sp" />
        </LinearLayout>
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>