<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar"
        android:layout_width="250dp"
        android:layout_height="match_parent"
        android:theme="@style/Theme.MediaVault.AppBarOverlay">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/toolbar_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:contentScrim="?attr/colorPrimary"
            app:toolbarId="@+id/toolbar">

            <ImageView
                android:id="@+id/iv_description_cover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/mediavault_logo"
                android:contentDescription="@string/image_url_path" />

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/Theme.MediaVault.PopupOverlay" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="250dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:id="@+id/tv_description_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sf_pro_bold"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="28sp"
                tools:text="Media Title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_description_type"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rating_pill_bg"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textColor="@color/accent_blue"
                    android:textSize="12sp"
                    android:fontFamily="@font/sf_pro_medium"
                    tools:text="ANIME" />

                <TextView
                    android:id="@+id/tv_description_genre"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/sf_pro_regular"
                    tools:text="Action, Adventure" />
            </LinearLayout>

            <RatingBar
                android:id="@+id/rb_description_rating"
                style="?android:attr/ratingBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:numStars="5"
                android:stepSize="0.5"
                android:progressTint="@color/accent_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/sf_pro_bold"
                android:text="@string/auto_description"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="18sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="true">

                <TextView
                    android:id="@+id/tv_description_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/sf_pro_regular"
                    android:textColor="?attr/colorTextSecondary"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"
                    android:text="@string/auto_lorem_ipsum_dolor_sit_amet_consectetur_adipiscin_2" />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:baselineAligned="false" android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_bold"
                        android:text="@string/status"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_description_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/sf_pro_regular"
                        android:textColor="?attr/colorTextSecondary"
                        android:textSize="16sp"
                        tools:text="Ongoing" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/sf_pro_bold"
                        android:text="@string/progress"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tv_description_progress_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/sf_pro_medium"
                        android:textColor="?attr/colorTextPrimary"
                        android:textSize="14sp"
                        tools:text="12 / 24 Episodes" />
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/pb_description_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="8dp"
                android:progressDrawable="@drawable/custom_progress_bar"
                tools:progress="60" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/sf_pro_bold"
                android:text="@string/auto_my_review_comment"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tv_description_my_review"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/sf_pro_regular"
                android:textColor="?attr/colorTextSecondary"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:fontStyle="italic"
                tools:text="Your personal thoughts will appear here..." />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:fontFamily="@font/sf_pro_bold"
                android:text="@string/auto_reviews"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="18sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_description_reviews"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_review" />

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="32dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_description_edit"
                    style="@style/BlueButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/auto_edit"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_edit_filled"
                    app:iconPadding="8dp" />

                <Button
                    android:id="@+id/btn_description_share"
                    style="@style/BlueButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/sf_pro_bold"
                    android:text="@string/auto_share"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_share_filled"
                    app:iconPadding="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_description_delete"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:textColor="@android:color/holo_red_dark"
                android:fontFamily="@font/sf_pro_bold"
                android:text="@string/auto_delete_media"
                android:textAllCaps="false"
                app:strokeColor="@android:color/holo_red_dark" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
