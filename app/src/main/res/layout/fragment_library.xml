<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/screen_section_spacing_small">

            <ImageView
                android:id="@+id/mediavault_logo"
                android:layout_width="@dimen/top_logo_size"
                android:layout_height="@dimen/top_logo_size"
                android:layout_marginStart="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/screen_padding_vertical"
                android:src="@drawable/mediavault_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_section_spacing_small"
                android:orientation="vertical"
                app:layout_constraintBottom_toBottomOf="@+id/mediavault_logo"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/mediavault_logo"
                app:layout_constraintTop_toTopOf="@id/mediavault_logo">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextScreenTitle"
                    android:text="@string/auto_library"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TextBody"
                    android:text="@string/auto_your_library"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/search_card"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginHorizontal="@dimen/screen_padding_horizontal"
                android:layout_marginTop="@dimen/screen_section_spacing"
                app:cardCornerRadius="27dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/glass_surface_color"
                app:strokeColor="@color/glass_border_soft"
                app:strokeWidth="1dp"
                app:layout_constraintTop_toBottomOf="@+id/mediavault_logo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_search"
                        app:tint="?attr/colorIconTint" />

                    <EditText
                        android:id="@+id/search_bar"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:background="@android:color/transparent"
                        android:hint="@string/auto_search_library"
                        android:inputType="text"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:textColor="?attr/colorTextPrimary"
                        android:textColorHint="?attr/colorTextSecondary" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:layout_marginHorizontal="8dp"
                        android:background="@color/glass_border" />

                    <ImageButton
                        android:id="@+id/btn_add_collection"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_add"
                        android:scaleType="centerInside"
                        android:contentDescription="@string/auto_add_collection"
                        app:tint="?attr/colorIconTint" />

                    <ImageButton
                        android:id="@+id/btn_filter"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/filter"
                        android:scaleType="centerInside"
                        app:tint="?attr/colorIconTint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <HorizontalScrollView
                android:id="@+id/chip_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/search_card">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_all"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_all"
                        android:checked="true"
                        app:chipBackgroundColor="@color/netflix_red"
                        android:textColor="@color/white"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_books"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/books"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_anime"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_anime"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_series"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_series"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_movies"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_movies"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <HorizontalScrollView
                android:id="@+id/status_chip_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginTop="12dp"
                android:clipToPadding="false"
                android:paddingHorizontal="@dimen/screen_padding_horizontal"
                app:layout_constraintTop_toBottomOf="@+id/chip_scroll">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="false"
                    app:chipSpacingHorizontal="8dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_collection_all"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/auto_all_collections"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_collection_ongoing"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_ongoing"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_collection_planning"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_planning"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_collection_completed"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_completed"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_collection_dropped"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_dropped"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_collection_favorites"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_favorites"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_collection_add"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/auto_collection"
                        android:checkable="false"
                        android:visibility="gone"
                        app:chipBackgroundColor="@color/chip_unselected_bg"
                        android:textColor="@color/chip_unselected_text"
                        app:chipCornerRadius="20dp"
                        app:chipStrokeWidth="0dp"/>
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="@dimen/screen_bottom_spacing"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        tools:listitem="@layout/item_media_card"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"/>

    <!-- Empty state -->
    <LinearLayout
        android:id="@+id/empty_state_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">
        
        <ImageView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_library"
            android:alpha="0.3"
            app:tint="?attr/colorTextSecondary"/>
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:text="@string/auto_your_vault_is_empty"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="18sp"
            android:fontFamily="@font/sf_pro_bold" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:text="@string/auto_add_your_first_media_to_get_started"
            android:textColor="?attr/colorTextSecondary"
            android:textSize="14sp"
            android:fontFamily="@font/sf_pro_regular" />
    </LinearLayout>

    <!-- No media found placeholder (legacy) -->
    <LinearLayout
        android:id="@+id/empty_state_view_legacy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_library"
            android:alpha="0.2"
            app:tint="@color/grey_600"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/auto_no_media_found"
            style="@style/TextSectionTitle" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auto_try_adjusting_your_search_or_filters"
            style="@style/TextBody" />
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
