<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/background_base">

    <TextView
        android:id="@+id/tv_manga_selector_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/auto_manga"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="12dp" />

    <ProgressBar
        android:id="@+id/pb_manga_chapters"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:visibility="gone"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tv_manga_chapter_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:visibility="gone"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:background="@drawable/glass_card_bg">

        <TextView
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="@string/auto_text_2"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/auto_chapter"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="@string/status"
            android:textStyle="bold"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_manga_chapter_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btn_open_current_chapter"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_continue_current_chapter"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:background="@drawable/glass_pill_bg"
        android:layout_marginBottom="10dp" />

    <Button
        android:id="@+id/btn_cancel_manga_selector"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/auto_cancel"
        android:textColor="@color/text_secondary"
        android:background="@drawable/glass_card_bg" />

</LinearLayout>

