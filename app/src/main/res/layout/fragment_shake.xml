<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_shake_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="Shake to Decide!"
        android:fontFamily="@font/sf_pro_bold"
        android:textSize="28sp"
        android:textColor="@color/text_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_shake_instructions"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Shake your phone to get a random recommendation from your library."
        android:fontFamily="@font/sf_pro_regular"
        android:textSize="18sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tv_shake_title"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageView
        android:id="@+id/iv_shake_icon"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/ic_shake"
        app:tint="@color/accent_blue"
        app:layout_constraintTop_toBottomOf="@id/tv_shake_instructions"
        app:layout_constraintBottom_toTopOf="@id/btn_shake_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btn_shake_back"
        style="@style/BlueButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="120dp"
        android:text="Back to Home"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>