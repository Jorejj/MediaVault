<?xml version="1.0" encoding="utf-8"?>
<!-- Magnetic Trash Can Delete Zone -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/trash_can_root"
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:background="@drawable/glass_card_bg"
    android:elevation="16dp"
    android:visibility="gone">

    <ImageView
        android:id="@+id/trash_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_centerInParent="true"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/vault_red_primary"
        android:contentDescription="@string/auto_delete_widget"
        android:alpha="0.8" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/trash_icon"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="4dp"
        android:text="@string/auto_remove"
        android:textSize="12sp"
        android:fontFamily="@font/sf_pro_medium"
        android:textColor="@color/vault_red_primary"
        android:alpha="0.8" />

</RelativeLayout>
