<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <queries>
        <!-- Browsers -->
        <package android:name="com.android.chrome" />
        <package android:name="org.mozilla.firefox" />
        <package android:name="com.brave.browser" />
        <package android:name="com.kiwibrowser.browser" />
        <package android:name="com.sec.android.app.sbrowser" />
        <package android:name="com.opera.browser" />
        <package android:name="com.duckduckgo.mobile.android" />
        <!-- Manga & Comics -->
        <package android:name="app.mihon.mihon" />
        <package android:name="eu.kanade.tachiyomi" />
        <package android:name="org.koitharu.kotatsu" />
        <package android:name="aniyomi.app" />
        <package android:name="com.naver.linewebtoon" />
        <package android:name="com.tapastic" />
        <package android:name="jp.co.shueisha.mangaplus" />
        <package android:name="com.qualson.tappytoon" />
        <!-- Novels & Books -->
        <package android:name="com.qidian.Int.reader" />
        <package android:name="com.flyersoft.moonreader" />
        <package android:name="com.flyersoft.moonreaderp" />
        <package android:name="wp.wattpad" />
        <package android:name="com.heitorcolin.lnreader" />
        <package android:name="org.readera" />
        <package android:name="com.amazon.kindle" />
        <!-- Media Players -->
        <package android:name="com.crunchyroll.crunchyroid" />
        <package android:name="com.netflix.mediaclient" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/mediavault_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/mediavault_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaVault">

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MediaVault.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <activity
            android:name=".OnboardingActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaVault" />
        
        <activity
            android:name=".ui.onboarding.PermissionWizardActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".AddMediaActivity"
            android:exported="false"
            android:label="Add New Media"
            android:theme="@style/Theme.MediaVault"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".DescriptionActivity"
            android:exported="false"
            android:label="Media Details"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".EditMediaActivity"
            android:exported="false"
            android:label="Edit Media"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".ProgressUpdateActivity"
            android:exported="false"
            android:label="Update Progress"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".EpisodeSelectorActivity"
            android:exported="false"
            android:label="Select Episode"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".MangaChapterSelectorActivity"
            android:exported="false"
            android:label="Select Chapter"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".MangaReaderActivity"
            android:exported="false"
            android:label="Manga Reader"
            android:theme="@style/Theme.MediaVault"
            android:configChanges="orientation|screenSize"
            android:screenOrientation="fullSensor" />

        <activity
            android:name=".ui.library.CollectionMediaPickerActivity"
            android:exported="false"
            android:label="Add to Collection"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".MoviePlayerActivity"
            android:exported="false"
            android:label="Loading Movie"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".TvSeriesPlayerActivity"
            android:exported="false"
            android:label="Select Episode"
            android:theme="@style/Theme.MediaVault" />

        <activity
            android:name=".EmbeddedWebPlayerActivity"
            android:exported="false"
            android:label="Web Player"
            android:theme="@style/Theme.MediaVault" />

        <receiver
            android:name=".receiver.MediaReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.mediavault.ACTION_MEDIA_UPDATED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".widget.MediaVaultWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.example.mediavault.ACTION_WIDGET_QUICK_PLUS" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/media_vault_widget_info" />
        </receiver>

        <receiver
            android:name=".receiver.DailyGoalReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".ReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaVault"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".PlayerActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaVault"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".SeriesDetailsActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaVault"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".TextReaderActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaVault"
            android:configChanges="orientation|screenSize" />

        <activity
            android:name=".cloud.auth.SupabaseAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.MediaVault" />

        <service
            android:name=".service.MediaMonitorService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
